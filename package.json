{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "tunnel:prod": "ssh -f -N -L 5433:/var/run/postgresql/.s.PGSQL.5432 deji@100.96.215.46",
    "sync:env": "for app in api worker bot; do rsync -avz apps/$app/.env.production deji@100.96.215.46:/opt/sentinel/apps/$app/.env; done",
    "logs:bot": "ssh deji@100.96.215.46 \"sudo journalctl -u sentinel-bot -f -n 100\"",
    "logs:worker": "ssh deji@100.96.215.46 \"sudo journalctl -u sentinel-worker -f -n 100\"",
    "logs:api": "ssh deji@100.96.215.46 \"sudo journalctl -u sentinel-api -f -n 100\"",
    "logs:prod": "ssh deji@100.96.215.46 \"sudo journalctl -u sentinel-bot -u sentinel-worker -u sentinel-api -f -n 100\"",
    "alliances:refresh-snapshot": "node scripts/refresh-faction-alliances-snapshot.js",
    "db:generate": "pnpm --filter @sentinel/database db:generate",
    "db:push": "pnpm --filter @sentinel/database db:push",
    "db:migrate": "pnpm --filter @sentinel/database db:migrate",
    "db:studio": "pnpm --filter @sentinel/database db:studio",
    "db:studio:prod": "DATABASE_URL=\"postgresql://deji@localhost:5433/sentinel\" pnpm --filter @sentinel/database db:studio",
    "key:add": "tsx scripts/add-api-key.ts",
    "key:prod": "DATABASE_URL=\"postgresql://deji@localhost:5433/sentinel\" pnpm tsx scripts/add-api-key.ts",
    "torn-types:generate": "pnpm --filter @sentinel/torn-api generate-types && pnpm --filter @sentinel/torn-api build",
    "worker:dev": "pnpm --filter worker dev",
    "worker:build": "pnpm --filter worker build",
    "worker:trigger": "tsx scripts/trigger-worker.ts",
    "bot:dev": "pnpm --filter bot dev",
    "bot:build": "pnpm --filter bot build",
    "bot:deploy-commands": "pnpm --filter bot deploy-commands",
    "api:dev": "pnpm --filter api dev",
    "api:build": "pnpm --filter api build",
    "bot-dashboard:dev": "pnpm --filter bot-dashboard dev",
    "bot-dashboard:build": "pnpm --filter bot-dashboard build",
    "user-dashboard:dev": "pnpm --filter user-dashboard dev",
    "user-dashboard:build": "pnpm --filter user-dashboard build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pidusage": "^2.0.5",
    "openapi-typescript": "^7.13.0",
    "repomix": "^1.17.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8"
  },
  "dependencies": {
    "pidusage": "^4.0.1"
  }
}
