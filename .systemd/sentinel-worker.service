[Unit]
Description=Sentinel Worker Service
After=network.target postgresql.service

[Service]
Type=simple
User=deji
WorkingDirectory=/opt/sentinel/apps/worker
ExecStart=/usr/bin/node --max-old-space-size=320 --expose-gc dist/index.cjs
Restart=always
RestartSec=5
EnvironmentFile=/opt/sentinel/apps/worker/.env
MemoryHigh=400M
MemoryMax=450M

[Install]
WantedBy=multi-user.target
