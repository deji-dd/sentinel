{
  "name": "@sentinel/worker",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs --bundle --minify --clean --out-dir dist",
    "start": "node dist/index.cjs",
    "test": "tsx src/scripts/test.ts"
  },
  "dependencies": {
    "@sentinel/database": "workspace:*",
    "@sentinel/schemas": "workspace:*",
    "@sentinel/torn-api": "workspace:*",
    "@sentinel/torn-api-manager": "workspace:*",
    "@sentinel/utils": "workspace:*",
    "cacheable-lookup": "^7.0.0",
    "dotenv": "^16.6.1",
    "undici": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
