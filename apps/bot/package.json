{
  "name": "@sentinel/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.cjs",
    "deploy-commands": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@sentinel/database": "workspace:*",
    "@sentinel/schemas": "workspace:*",
    "@sentinel/torn-api": "workspace:*",
    "@sentinel/torn-api-manager": "workspace:*",
    "@sentinel/utils": "workspace:*",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
