{
  "name": "@sentinel/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs --bundle --minify --clean --out-dir dist",
    "start": "node dist/index.cjs",
    "deploy-commands": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "@sentinel/database": "workspace:*",
    "@sentinel/schemas": "workspace:*",
    "@sentinel/torn-api": "workspace:*",
    "@sentinel/torn-api-manager": "workspace:*",
    "@sentinel/utils": "workspace:*",
    "@types/sharp": "^0.32.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
