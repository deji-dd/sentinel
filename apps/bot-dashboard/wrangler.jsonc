{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sentinel-bot-dashboard",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sentinel-bot-dashboard"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.blasted-labs.tech",
    "NEXT_PUBLIC_APP_URL": "https://blasted-labs.tech",
    "NODE_ENV": "production",
    "NEXTAUTH_URL": "https://blasted-labs.tech",
    "AUTH_TRUST_HOST": "true"
  }
}