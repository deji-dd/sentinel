{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": [
        "prisma/generated/**",
        "node_modules/.prisma/client/**",
        "node_modules/@prisma/client/**"
      ]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["src/**", "prisma/**", "package.json", "tsconfig*.json", "tsup.config.ts"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "prisma/generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    }
  }
}
